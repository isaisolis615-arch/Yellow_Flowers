---
interface Props {
  photos: Array<{
    src: string;
    alt: string;
    date?: string;
  }>;
  notes: Array<{
    id: string;
    type: 'postit' | 'carta' | 'poema';
    content: string;
    photoIndex?: number;
    stickyColor?: 'amarillo' | 'verde' | 'azul' | 'rosa' | 'naranja';
  }>;
}

const { photos, notes } = Astro.props;

// Create a map of notes by photoIndex for easy lookup
const notesByPhotoIndex = new Map<number, typeof notes>();
notes.forEach(note => {
  if (note.photoIndex !== undefined && note.photoIndex !== null) {
    if (!notesByPhotoIndex.has(note.photoIndex)) {
      notesByPhotoIndex.set(note.photoIndex, []);
    }
    notesByPhotoIndex.get(note.photoIndex)!.push(note);
  }
});

// Sticky note colors cycle
const stickyColors = ['amarillo', 'verde', 'azul', 'rosa', 'naranja'] as const;
let stickyColorIndex = 0;

function getNextStickyColor() {
  const color = stickyColors[stickyColorIndex % stickyColors.length];
  stickyColorIndex++;
  return color;
}
---

<section class="story-timeline" aria-labelledby="story-title">
  <div class="container">
    <h2 id="story-title" class="section__title animate-fade-in">Nuestra Historia</h2>
    
    <div class="story-timeline__content" role="list">
      {photos.map((photo, index) => (
        <>
          <figure class="story-timeline__photo" role="listitem" data-index={index}>
            <div class="photo-frame">
              <img
                src={photo.src}
                alt={photo.alt}
                loading={index < 4 ? 'eager' : 'lazy'}
                decoding="async"
                width="400"
                height="400"
              />
            </div>
          </figure>

          {notesByPhotoIndex.has(index) && notesByPhotoIndex.get(index)!.map((note, noteIdx) => (
            <article 
              class={`sticky-note sticky-note--${getNextStickyColor()} animate-slide-up`}
              role="listitem"
              style={{ animationDelay: `${(index * 2 + noteIdx) * 100}ms` }}
            >
              {note.type === 'poema' ? (
                <div class="sticky-note__poema">
                  {note.content.split('\n').map(line => <p>{line}</p>)}
                </div>
              ) : (
                <p>{note.content}</p>
              )}
            </article>
          ))}
        </>
      ))}

      {/* Notes without photoIndex - standalone notes */}
      {notes.filter(note => note.photoIndex === undefined || note.photoIndex === null).map((note, idx) => (
        <article 
          class={`sticky-note sticky-note--${getNextStickyColor()} animate-slide-up sticky-note--standalone`}
          role="listitem"
          style={{ animationDelay: `${(photos.length * 2 + idx) * 100}ms` }}
        >
          {note.type === 'poema' ? (
            <div class="sticky-note__poema">
              {note.content.split('\n').map(line => <p>{line}</p>)}
            </div>
          ) : (
            <p>{note.content}</p>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .story-timeline {
    padding: var(--space-xl) 0;
  }

  .story-timeline__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 480px;
    margin: 0 auto;
  }

  .story-timeline__photo {
    margin: var(--space-lg) auto;
    max-width: 380px;
  }

  .photo-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    padding: 40px;
    border-width: 20px;
    border-style: solid;
    border-color: #2F2D2D #434040 #4F4C4C #434040;
    background: #f5f5f5;
    background-image: linear-gradient(#E5E4DF, #CDCDC6);
    box-shadow: 
      inset 0 2px 5px rgba(0,0,0,.6),
      0 5px 2px rgba(0,0,0,.1),
      0 10px 20px rgba(0,0,0,.8);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    transform: rotate(var(--rotation, 0deg));
  }

  .photo-frame::before {
    content: "";
    position: absolute;
    top: -175px;
    right: -20%;
    width: 400px;
    height: 400px;
    transform: rotateZ(-40deg);
    background-image: linear-gradient(rgba(255,255,255,.4), rgba(255,255,255,0));
    pointer-events: none;
  }

  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-width: 2px;
    border-style: solid;
    border-color: #BBBAB4 #C7C7BF #E5E4DF #C7C7BF;
    box-shadow: 
      0 -1px 1px rgba(0,0,0,.1),
      0 1px 1px 1px rgba(255,255,255,.7);
    border-radius: 4px;
    transition: transform var(--transition-slow) ease-out;
  }

  .story-timeline__photo:hover .photo-frame img {
    transform: scale(1.02);
  }

  /* Random rotation for each photo */
  .story-timeline__photo:nth-child(1) .photo-frame { --rotation: -2deg; }
  .story-timeline__photo:nth-child(3) .photo-frame { --rotation: 1.5deg; }
  .story-timeline__photo:nth-child(5) .photo-frame { --rotation: -1deg; }
  .story-timeline__photo:nth-child(7) .photo-frame { --rotation: 2deg; }
  .story-timeline__photo:nth-child(9) .photo-frame { --rotation: -1.5deg; }
  .story-timeline__photo:nth-child(11) .photo-frame { --rotation: 1deg; }
  .story-timeline__photo:nth-child(13) .photo-frame { --rotation: -2.5deg; }
  .story-timeline__photo:nth-child(15) .photo-frame { --rotation: 2deg; }
  .story-timeline__photo:nth-child(17) .photo-frame { --rotation: -1deg; }
  .story-timeline__photo:nth-child(19) .photo-frame { --rotation: 1.5deg; }
  .story-timeline__photo:nth-child(21) .photo-frame { --rotation: -2deg; }

  .story-timeline__photo:hover {
    transform: translateY(-8px);
    z-index: 10;
  }

  .story-timeline__photo:hover .photo-frame {
    box-shadow: 
      inset 0 2px 5px rgba(0,0,0,.6),
      0 5px 2px rgba(0,0,0,.1),
      0 20px 40px rgba(0,0,0,.5);
    transform: rotate(0deg) scale(1.02);
  }

  .sticky-note {
    position: relative;
    width: 100%;
    max-width: 380px;
    min-height: 160px;
    padding: var(--space-lg) var(--space-xl);
    margin: var(--space-md) auto;
    box-sizing: border-box;
    font-family: var(--font-sticky);
    font-size: var(--fs-lg);
    line-height: 1.4;
    color: var(--color-negro-suave);
    box-shadow: 
      5px 5px 15px rgba(33, 33, 33, 0.3),
      inset 0 0 0 1px rgba(0, 0, 0, 0.05);
    border-radius: 2px;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), z-index 0s;
    word-wrap: break-word;
    white-space: pre-wrap;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .sticky-note::before {
    content: '';
    position: absolute;
    bottom: 10px;
    right: 10px;
    width: 60%;
    height: 20px;
    background: rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    filter: blur(8px);
    z-index: -1;
    transform: rotate(3deg);
  }

  .sticky-note:hover {
    transform: scale(1.05) rotate(0deg) !important;
    box-shadow: 
      10px 10px 25px rgba(33, 33, 33, 0.4),
      inset 0 0 0 1px rgba(0, 0, 0, 0.08);
    z-index: 10;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .sticky-note--amarillo { background: var(--sticky-amarillo); transform: rotate(-2deg); }
  .sticky-note--verde { background: var(--sticky-verde); transform: rotate(3deg); }
  .sticky-note--azul { background: var(--sticky-azul); transform: rotate(-3deg); }
  .sticky-note--rosa { background: var(--sticky-rosa); transform: rotate(2deg); }
  .sticky-note--naranja { background: var(--sticky-naranja); transform: rotate(-4deg); }

  .sticky-note:hover {
    transform: scale(1.15) rotate(0deg) !important;
    box-shadow: 
      15px 15px 30px rgba(33, 33, 33, 0.4),
      inset 0 0 0 1px rgba(0, 0, 0, 0.1);
    z-index: 20;
  }

  .sticky-note__poema {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    width: 100%;
  }

  .sticky-note__poema p {
    margin: 0;
  }

  .sticky-note--standalone {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  @media (max-width: 480px) {
    .story-timeline__photo {
      max-width: 100%;
    }

    .photo-frame {
      padding: 24px;
      border-width: 12px;
    }

    .photo-frame::before {
      top: -120px;
      width: 250px;
      height: 250px;
    }

    .sticky-note {
      max-width: 100%;
      min-height: 140px;
      padding: var(--space-md) var(--space-lg);
      font-size: var(--fs-base);
      margin: var(--space-md) var(--space-sm);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story-timeline__photo,
    .sticky-note {
      animation: none !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
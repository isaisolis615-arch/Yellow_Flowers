---
interface Props {
  photos: Array<{
    src: string;
    alt: string;
    special?: boolean;
    year?: number;
  }>;
}

const { photos } = Astro.props;
---

<section class="photo-masonry" aria-label="Galería de fotos">
  <div class="photo-masonry__grid" role="list">
    {photos.map((photo, index) => (
      <figure class="photo-masonry__item" role="listitem" data-index={index} data-special={photo.special ? 'true' : 'false'}>
        <img
          src={photo.src}
          alt={photo.alt}
          loading={index < 4 ? 'eager' : 'lazy'}
          decoding="async"
          width="400"
          height="400"
        />
        {photo.special && (
          <figcaption class="photo-masonry__badge">
            <span class="photo-masonry__badge-icon" aria-hidden="true">✨</span>
            <span>Especial</span>
          </figcaption>
        )}
        {photo.year && (
          <figcaption class="photo-masonry__year">{photo.year}</figcaption>
        )}
      </figure>
    ))}
  </div>
</section>

<style>
  .photo-masonry {
    padding: var(--space-xl) 0;
  }

  .photo-masonry__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--space-md);
    align-items: start;
  }

  .photo-masonry__item {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--paper-bg);
    box-shadow: var(--shadow-soft);
    cursor: zoom-in;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    aspect-ratio: 1 / 1;
  }

  .photo-masonry__item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-medium);
  }

  .photo-masonry__item[data-special="true"] {
    box-shadow: 0 0 0 3px var(--color-amarillo-medio), var(--shadow-medium);
  }

  .photo-masonry__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    transition: transform var(--transition-slow) ease-out;
  }

  .photo-masonry__item:hover img {
    transform: scale(1.05);
  }

  .photo-masonry__badge {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
    background: rgba(0, 0, 0, 0.7);
    color: var(--color-amarillo-medio);
    border-radius: var(--radius-full);
    font-family: var(--font-ui);
    font-size: var(--fs-xs);
    font-weight: 500;
    backdrop-filter: blur(4px);
    z-index: 2;
  }

  .photo-masonry__badge-icon {
    font-size: var(--fs-sm);
    animation: sparkle 1.5s ease-in-out infinite;
  }

  @keyframes sparkle {
    0%, 100% { transform: scale(1) rotate(0deg); opacity: 1; }
    50% { transform: scale(1.2) rotate(10deg); opacity: 0.8; }
  }

  .photo-masonry__year {
    position: absolute;
    bottom: var(--space-sm);
    left: var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    background: rgba(0, 0, 0, 0.6);
    color: var(--color-blanco-hueso);
    border-radius: var(--radius-full);
    font-family: var(--font-ui);
    font-size: var(--fs-xs);
    font-weight: 500;
    backdrop-filter: blur(4px);
    z-index: 2;
  }

  @media (max-width: 480px) {
    .photo-masonry__grid {
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 160px), 1fr));
      gap: var(--space-sm);
    }
    .photo-masonry__item {
      border-radius: var(--radius-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-masonry__item,
    .photo-masonry__item img,
    .photo-masonry__badge-icon {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  const items = document.querySelectorAll('.photo-masonry__item');
  items.forEach((item, index) => {
    item.style.animationDelay = `${index * 50}ms`;
    item.classList.add('animate-slide-up');
  });
</script>
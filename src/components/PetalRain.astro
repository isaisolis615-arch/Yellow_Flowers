---
interface Props {
  trigger?: 'scroll' | 'click' | 'auto';
}

const { trigger = 'scroll' } = Astro.props;
---

<canvas id="petal-canvas" class="petal-canvas" aria-hidden="true" hidden data-trigger={trigger}></canvas>

<style>
  .petal-canvas {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 50;
    opacity: 0;
    transition: opacity var(--transition-slow);
  }

  .petal-canvas--active {
    opacity: 1;
    hidden: false;
  }
</style>

<script>
  const canvas = document.getElementById('petal-canvas');
  const ctx = canvas.getContext('2d');
  let petals = [];
  let animationId = null;
  let active = false;
  let width = 0;
  let height = 0;

  // Leer trigger desde data attribute
  const trigger = canvas.dataset.trigger || 'scroll';

  const petalColors = [
    '#FFE8A0', '#FFD66B', '#F5C04A',
    '#FFE4EC', '#FADADD', '#FFF0F5',
    '#C8E6C9', '#A5D6A7', '#81C784'
  ];

  const petalShapes = [
    drawPetalClassic,
    drawPetalRound,
    drawPetalHeart
  ];

  function resize() {
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = width * devicePixelRatio;
    canvas.height = height * devicePixelRatio;
    canvas.style.width = width + 'px';
    canvas.style.height = height + 'px';
    ctx.scale(devicePixelRatio, devicePixelRatio);
  }

  function drawPetalClassic(ctx, x, y, size, rotation, color) {
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(rotation);
    ctx.beginPath();
    ctx.moveTo(0, -size);
    ctx.bezierCurveTo(size * 0.5, -size * 0.5, size * 0.5, size * 0.5, 0, size);
    ctx.bezierCurveTo(-size * 0.5, size * 0.5, -size * 0.5, -size * 0.5, 0, -size);
    ctx.fillStyle = color;
    ctx.fill();
    ctx.restore();
  }

  function drawPetalRound(ctx, x, y, size, rotation, color) {
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(rotation);
    ctx.beginPath();
    ctx.ellipse(0, 0, size * 0.6, size, 0, 0, Math.PI * 2);
    ctx.fillStyle = color;
    ctx.fill();
    ctx.restore();
  }

  function drawPetalHeart(ctx, x, y, size, rotation, color) {
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(rotation);
    ctx.beginPath();
    const s = size;
    ctx.moveTo(0, s * 0.3);
    ctx.bezierCurveTo(-s * 0.8, -s * 0.2, -s, -s * 0.8, 0, -s);
    ctx.bezierCurveTo(s, -s * 0.8, s * 0.8, -s * 0.2, 0, s * 0.3);
    ctx.fillStyle = color;
    ctx.fill();
    ctx.restore();
  }

  class Petal {
    constructor() {
      this.reset();
    }

    reset() {
      this.x = Math.random() * width;
      this.y = -20 - Math.random() * height * 0.5;
      this.size = 8 + Math.random() * 16;
      this.color = petalColors[Math.floor(Math.random() * petalColors.length)];
      this.shape = petalShapes[Math.floor(Math.random() * petalShapes.length)];
      this.rotation = Math.random() * Math.PI * 2;
      this.rotationSpeed = (Math.random() - 0.5) * 0.02;
      this.fallSpeed = 0.5 + Math.random() * 1.5;
      this.sway = Math.random() * 0.5 + 0.5;
      this.swaySpeed = 0.005 + Math.random() * 0.01;
      this.swayOffset = Math.random() * Math.PI * 2;
      this.opacity = 0.7 + Math.random() * 0.3;
    }

    update(deltaTime) {
      this.y += this.fallSpeed * deltaTime * 0.06;
      this.x += Math.sin(Date.now() * this.swaySpeed + this.swayOffset) * this.sway * deltaTime * 0.01;
      this.rotation += this.rotationSpeed * deltaTime * 0.06;

      if (this.y > height + 20 || this.x < -20 || this.x > width + 20) {
        this.reset();
        this.y = -20;
      }
    }

    draw() {
      ctx.globalAlpha = this.opacity;
      this.shape(ctx, this.x, this.y, this.size, this.rotation, this.color);
      ctx.globalAlpha = 1;
    }
  }

  function initPetals(count = 40) {
    petals = [];
    for (let i = 0; i < count; i++) {
      const petal = new Petal();
      petal.y = Math.random() * height;
      petals.push(petal);
    }
  }

  function animate(timestamp) {
    if (!active) return;

    ctx.clearRect(0, 0, width, height);

    const deltaTime = timestamp - (animate.lastTime || timestamp);
    animate.lastTime = timestamp;

    petals.forEach(petal => {
      petal.update(deltaTime);
      petal.draw();
    });

    animationId = requestAnimationFrame(animate);
  }

  function start() {
    if (active) return;
    active = true;
    canvas.hidden = false;
    requestAnimationFrame(() => {
      canvas.classList.add('petal-canvas--active');
    });
    if (!animationId) {
      animate.lastTime = performance.now();
      animationId = requestAnimationFrame(animate);
    }
  }

  function stop() {
    active = false;
    canvas.classList.remove('petal-canvas--active');
    setTimeout(() => {
      if (!active) canvas.hidden = true;
    }, 500);
    if (animationId) {
      cancelAnimationFrame(animationId);
      animationId = null;
    }
  }

  window.addEventListener('resize', resize);
  resize();
  initPetals();

  if (trigger === 'auto') {
    start();
  } else if (trigger === 'scroll') {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) start();
      });
    }, { threshold: 0.1 });

    const triggerElement = document.querySelector('[data-petal-trigger]') || document.querySelector('footer');
    if (triggerElement) observer.observe(triggerElement);
  }

  window.startPetalRain = start;
  window.stopPetalRain = stop;

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReducedMotion) {
    canvas.style.display = 'none';
  }
</script>
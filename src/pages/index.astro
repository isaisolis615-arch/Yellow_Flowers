---
import Layout from '../layouts/Layout.astro';
import GiftBox3D from '../components/GiftBox3D.astro';
import StoryTimeline from '../components/StoryTimeline.astro';
import Lightbox from '../components/Lightbox.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import PetalRain from '../components/PetalRain.astro';
import photos from '../data/photos.json';
import notes from '../data/notes.json';

const pageTitle = 'Ramos de Sol 🌻';
const pageDescription = 'Un regalo especial para mi mejor amiga: nuestras fotos, recuerdos y rosas amarillas';
---

<Layout title={pageTitle} description={pageDescription}>
  <GiftBox3D />

  <main id="main-content" class="main-content" hidden>
    <header class="hero" data-petal-trigger>
      <h1 class="hero__title animate-fade-in">Ramos de Sol</h1>
      <p class="hero__subtitle animate-slide-up stagger-1">Para mi mejor amiga, con todo mi cariño</p>
      <div class="hero__divider animate-slide-up stagger-2" aria-hidden="true">
        <span class="hero__flower">🌻</span>
        <span class="hero__flower">🌻</span>
        <span class="hero__flower">🌻</span>
      </div>
    </header>

    <StoryTimeline photos={photos} notes={notes} />

    <section class="section section--final" aria-labelledby="final-title">
      <div class="container">
        <h2 id="final-title" class="section__title animate-fade-in">Siempre Juntos</h2>
        <div class="final__content animate-slide-up">
          <div class="sticky-note sticky-note--amarillo animate-slide-up" style="max-width: 500px; margin: var(--space-xl) auto;">
            <div class="sticky-note__poema">
              <p>No hace falta un día especial</p>
              <p>Para recordarte lo mucho que significas</p>
              <p>Cada rosa de este ramo virtual</p>
              <p>Lleva tu nombre escrito en el corazón</p>
              <p></p>
              <p>Gracias por ser mi sol en los días nublados</p>
              <p>Mi risa cuando quiero llorar</p>
              <p>Mi hogar en forma de persona</p>
              <p></p>
              <p>Te quiero hoy, mañana y siempre</p>
              <p>Mi mejor amiga, mi hermana del alma</p>
              <p></p>
              <p>🌻 Con todo mi cariño 🌻</p>
              <p>La quiero Mada</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div id="flower-animation" class="flower-animation" hidden>
      <div class="night"></div>
      <div class="flowers">
        <div class="flower flower--1">
          <div class="flower__leafs flower__leafs--1">
            <div class="flower__leaf flower__leaf--1"></div>
            <div class="flower__leaf flower__leaf--2"></div>
            <div class="flower__leaf flower__leaf--3"></div>
            <div class="flower__leaf flower__leaf--4"></div>
            <div class="flower__white-circle"></div>

            <div class="flower__light flower__light--1"></div>
            <div class="flower__light flower__light--2"></div>
            <div class="flower__light flower__light--3"></div>
            <div class="flower__light flower__light--4"></div>
            <div class="flower__light flower__light--5"></div>
            <div class="flower__light flower__light--6"></div>
            <div class="flower__light flower__light--7"></div>
            <div class="flower__light flower__light--8"></div>

          </div>
          <div class="flower__line">
            <div class="flower__line__leaf flower__line__leaf--1"></div>
            <div class="flower__line__leaf flower__line__leaf--2"></div>
            <div class="flower__line__leaf flower__line__leaf--3"></div>
            <div class="flower__line__leaf flower__line__leaf--4"></div>
            <div class="flower__line__leaf flower__line__leaf--5"></div>
            <div class="flower__line__leaf flower__line__leaf--6"></div>
          </div>
        </div>

        <div class="flower flower--2">
          <div class="flower__leafs flower__leafs--2">
            <div class="flower__leaf flower__leaf--1"></div>
            <div class="flower__leaf flower__leaf--2"></div>
            <div class="flower__leaf flower__leaf--3"></div>
            <div class="flower__leaf flower__leaf--4"></div>
            <div class="flower__white-circle"></div>

            <div class="flower__light flower__light--1"></div>
            <div class="flower__light flower__light--2"></div>
            <div class="flower__light flower__light--3"></div>
            <div class="flower__light flower__light--4"></div>
            <div class="flower__light flower__light--5"></div>
            <div class="flower__light flower__light--6"></div>
            <div class="flower__light flower__light--7"></div>
            <div class="flower__light flower__light--8"></div>

          </div>
          <div class="flower__line">
            <div class="flower__line__leaf flower__line__leaf--1"></div>
            <div class="flower__line__leaf flower__line__leaf--2"></div>
            <div class="flower__line__leaf flower__line__leaf--3"></div>
            <div class="flower__line__leaf flower__line__leaf--4"></div>
          </div>
        </div>

        <div class="flower flower--3">
          <div class="flower__leafs flower__leafs--3">
            <div class="flower__leaf flower__leaf--1"></div>
            <div class="flower__leaf flower__leaf--2"></div>
            <div class="flower__leaf flower__leaf--3"></div>
            <div class="flower__leaf flower__leaf--4"></div>
            <div class="flower__white-circle"></div>

            <div class="flower__light flower__light--1"></div>
            <div class="flower__light flower__light--2"></div>
